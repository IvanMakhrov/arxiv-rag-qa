FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
COPY utils ./utils

RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir -e .[celery]

ENV PYTHONPATH=/app/utils:/app/src:$PYTHONPATH

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD celery -A arxiv_rag_qa.celery_config inspect ping --quiet 2>/dev/null || exit 1

CMD ["celery", "-A", "arxiv_rag_qa.celery_config", "worker", \
     "--loglevel=info", \
     "--concurrency=1", \
     "--pool=solo", \
     "--max-tasks-per-child=10", \
     "--hostname=worker@%h"]
